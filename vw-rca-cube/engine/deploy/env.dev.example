# Copy to .env.dev next to docker-compose.dev.yml (chmod 600). Values are NOT committed.
# Pair with LOCAL_DEV.md, which explains where each value comes from and what it's for.
#
# RULES (repeated from LOCAL_DEV.md because getting these wrong affects production):
#   - Never put a PRODUCTION CUBE_API_SECRET, CONVEX_URL or CONVEX_ADMIN_KEY in this file.
#   - Never run this with TUNNEL=1 pointed at the PRODUCTION Convex deployment: the engine
#     publishes its tunnel URL there, and every user's browser would start calling your machine.

# --- Your own Convex (from `npx convex dev --once`) ---
CONVEX_URL=https://<your-dev-deployment>.convex.cloud
CONVEX_ADMIN_KEY=                 # your dev deployment's deploy key, NOT production's

# --- Cube: the SHARED one, read-only, reached by its published host port (not the Docker
#     network name production uses) ---
CUBE_API_URL=http://10.6.2.34:4002   # no trailing /cubejs-api
CUBE_API_SECRET=                     # ask whoever runs cube-rca; same as its CUBEJS_API_SECRET
# Only needed once you swap to your own Cube model (see CLAUDE.md "Cube models"):
# CUBE_API_URL=http://10.6.2.34:4003

# --- Test credentials: hash your OWN test passwords, never copy production's hashes ---
DASHBOARD_PASSWORD_SHA256=        # sha256 hex, e.g. printf '%s' 'a-test-password' | shasum -a 256
ADMIN_PASSWORD_SHA256=            # same, for the Settings/admin password
ADMIN_SECRET=                     # any random string; guards POST /admin/rebuild

# --- Where your Vercel project will live ---
ALLOWED_ORIGINS=https://<your-project>.vercel.app

# --- Leave unset in dev, or the "Raise a question" button files real Jira tickets / Slack posts ---
# JIRA_BASE_URL=
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# JIRA_PROJECT_KEY=
# RAISE_QUESTION_WEBHOOK_URL=
