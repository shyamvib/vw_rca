# TEMPLATE ONLY: do not put real values in this file (it is committed to git).
# On the server, copy it to .env.dev in the folder you run docker compose from, chmod 600, and fill in THAT copy.
# Walkthrough: HOSTING_THIRU_DEV.md. Put each comment on its own line: docker env files keep text after "=" as part of the value.
#
# RULES (getting these wrong affects production, not just your copy):
#   - CONVEX_URL and CONVEX_ADMIN_KEY must be YOUR Convex project's, never production's: this engine runs a
#     quick tunnel (TUNNEL=1 in the compose file) and publishes its address to whatever Convex is set here.
#   - Never use production's password hashes.

# --- Shared Cube, read-only, reached on its published port (secret from whoever runs cube-rca) ---
CUBE_API_URL=http://10.6.2.34:4002
CUBE_API_SECRET=
# Later, your own Cube (only after the compatibility views exist and it has an API secret):
# CUBE_API_URL=http://10.6.2.34:4003

# --- YOUR Convex project: production deployment URL and its production deploy key ---
CONVEX_URL=https://<your-deployment>.convex.cloud
CONVEX_ADMIN_KEY=

# --- Your own test passwords, hashed (must equal what you set in your Convex) ---
# printf '%s' 'your-test-password' | shasum -a 256 | cut -d' ' -f1
DASHBOARD_PASSWORD_SHA256=
ADMIN_PASSWORD_SHA256=
# Any long random string (openssl rand -hex 24); guards POST /admin/rebuild
ADMIN_SECRET=

# --- Your Vercel address (comma-separate several) ---
ALLOWED_ORIGINS=https://<your-project>.vercel.app

# --- Leave these unset in a dev copy, or "Raise a question" files real Jira tickets / Slack posts ---
# JIRA_BASE_URL=
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# JIRA_PROJECT_KEY=
# RAISE_QUESTION_WEBHOOK_URL=
