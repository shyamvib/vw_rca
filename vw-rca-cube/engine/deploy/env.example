# Copy to .env on the server (chmod 600). Values are NOT committed.
CUBE_API_SECRET=            # same as CUBEJS_API_SECRET of the cube-rca container
CONVEX_URL=https://<deployment>.convex.cloud
CONVEX_ADMIN_KEY=           # the Convex production deploy key (works as admin key for internal functions)
DASHBOARD_PASSWORD_SHA256=  # sha256 hex of the shared dashboard password (same as the Convex env var)
ADMIN_PASSWORD_SHA256=      # sha256 hex of the admin (Settings) password
ADMIN_SECRET=               # random string; guards POST /admin/rebuild
ALLOWED_ORIGINS=https://vw-rca.vercel.app
# "Raise a question" -> Jira (optional; without these the button falls back to RAISE_QUESTION_WEBHOOK_URL, or errors)
JIRA_BASE_URL=              # https://<site>.atlassian.net
JIRA_EMAIL=                 # the Atlassian account that owns the API token (shown as the issue reporter)
JIRA_API_TOKEN=             # created by that account at id.atlassian.com > Security > API tokens
JIRA_PROJECT_KEY=           # e.g. RCA
# JIRA_ISSUE_TYPE=Task      # optional, must exist in the project
# JIRA_LABELS=rca-dashboard # optional, comma list
# Request portal (Jira Service Management) instead of a plain project: set these INSTEAD of JIRA_PROJECT_KEY
# JIRA_BASE_URL=https://vibrantamerica.atlassian.net
# JIRA_SERVICE_DESK_ID=39          # usually the number in /servicedesk/customer/portal/39; /admin/jira-check confirms
# JIRA_REQUEST_TYPE_ID=            # leave empty first: /admin/jira-check lists the request types with their ids
# JIRA_RAISE_ON_BEHALF=1           # optional: file it as the asker (needs an agent account that may do that)
