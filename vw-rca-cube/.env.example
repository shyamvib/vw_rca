# --- Vercel (frontend build-time) ---
VITE_CONVEX_URL=https://<your-deployment>.convex.cloud
VITE_VIKTOR_SPACES_ACCESS_MODE=public

# --- Convex deployment env (set with `npx convex env set NAME value`) ---
# VIKTOR_SPACES_ACCESS_MODE=public
# DASHBOARD_PASSWORD_SHA256=<echo -n "password" | shasum -a 256>
# ADMIN_PASSWORD_SHA256=<same for the admin password>
# The analytics service has its own env: see engine/deploy/env.example
